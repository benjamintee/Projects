# Quarto build output — regenerated by CI, never commit
/_site/
/.quarto/
*_files/
*_cache/

# DO NOT ignore /_freeze/ — it must be committed so GitHub Actions can
# publish without installing R or Python.

# Editors / OS
.DS_Store
Thumbs.db
.vscode/
.Rproj.user/
.Rhistory

# Python
__pycache__/
.venv/
*.pyc

# Large raw data — keep it out of git, document the source instead
/data/raw/
*.gpkg
*.tif
*.shp
*.zip
